;   param=value ; assign values to parameters

config_version=5

[application]

config/name="slimecrimeMP"
run/main_scene="res://world/sandbox.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SpacetimeDB="*res://spacetime_bindings/schema/spacetime_autoload.gd"
Net="*res://net/net.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/SpacetimeDB/plugin.cfg")

